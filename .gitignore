# .gitignore for agent-verification

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Python / Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / Editor Files
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary & Scratch Files
scratch/
tmp/
*.tmp
*.log

# Skill optimization pipeline (generated locally, never committed)
optimization/dataset/data/
optimization/fixtures/good_contract.json
optimization/fixtures/bad_contract.json
optimization/runs/
optimization/skillopt/runs/
optimization/hermit/runs/
.venv/
.demo/
